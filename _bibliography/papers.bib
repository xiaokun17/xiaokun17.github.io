}

@article{202309_WangTiancheng_Simulating,
  title = {Simulating Hyperelastic Materials with Anisotropic Stiffness Models in a Particle-Based Framework},
  author = {Wang, Tiancheng and Xu, Yanrui and Li, Ruolan and Wang, Haoping and Xiong, Yuege and Wang, Xiaokun},
