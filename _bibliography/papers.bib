@inproceedings{202410_FangSong_Shape,
  title = {Shape Prior Enhanced U-Net Model for Medical Image Segmentation},
  author = {Fang, Song and Wang, Jiamin and Zhao, Zirun and Wei, Chaopeng and Zhang, Xudong and Wang, Jiaxin and Obaidat, Mohammad S. and Wang, Xiaokun},
