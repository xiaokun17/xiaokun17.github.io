@unpublished{202407_WangHaoping_PeridynamicBased,
  title = {Peridynamic-Based Modeling of Elastoplasticity and Fracture Dynamics},
  author = {Wang, Haoping and Wang, Xiaokun and Xu, Yanrui and Zang, Yanlan and Yao, Chao and Guo, Yu and Ban, Xiaojuan},
  journal = {Computer Animation and Virtual Worlds},
  year = {2024},
