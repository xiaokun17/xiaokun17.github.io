@article{202201_XieYuanyan_Indoor,
  title = {Indoor Visual Re-Localization for Long-Term Autonomous Robots Based on Object-Level Features and Semantic Relationships},
  author = {Xie, Yuanyan and Guo, Yu and Mi, Zhenqiang and Wang, Xiaokun and Yang, Yang and Obaidat, Mohammad S.},
  journal = {IEEE Robotics and Automation Letters},
