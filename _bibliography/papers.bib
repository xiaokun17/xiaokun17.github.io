@article{202504_XuYuanmu_Physics,
  title = {Physics and Geometry-Augmented Neural Implicit Surfaces for Rigid Bodies},
  author = {Xu, Yuanmu and Hou, Guanli and Hu, Jiangbei and Ren, Tenglong and Wang, Xiaokun and Zhang, Yalan and Ban, Xiaojuan and Qian, Chen and Hou, Fei and He, Ying},
  journal = {Computer Aided Geometric Design},
  year = {2025},
