@article{202303_WangXiaokun_Implicit,
  title = {Implicit Smoothed Particle Hydrodynamics Model for Simulating Incompressible Fluid-Elastic Coupling},
  author = {Wang, Xiaokun and Wang, Tiancheng and Wang, Jiamin and Xu, Yanrui and Ban, Xiaojuan and Huang, Houbin and Zhu, Zhihong and Chang, Jian and Zhang, Jian Jun},
