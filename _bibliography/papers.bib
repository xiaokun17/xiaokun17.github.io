@article{202212_XuYanrui_Volume,
  title = {Volume Flux Free SPH Approach for Multiphase Fluids},
  author = {Xu, Yanrui and Wang, Xiaokun and Ban, Xiaojuan and Wang, Jiamin and Song, Chongming and Wang, Yong},
  journal = {Journal of Computer-Aided Design \& Computer Graphics},
